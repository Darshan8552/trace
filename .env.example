DATABASE_URL=
DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Trace

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN=

# Comma-separated bootstrap/break-glass allowlist for /admin (roles are primary)
ADMIN_EMAILS=
# Machine auth for POST /api/admin/reindex (32+ characters); optional
REINDEX_SECRET=

GOOGLE_GENERATIVE_AI_API_KEY=
AI_CHAT_PROVIDER=google
AI_CHAT_MODEL=gemini-3.5-flash-lite
AI_EMBEDDING_PROVIDER=google
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=1536

# Opt-in ingestion features (1/true to enable)
INGEST_SPREADSHEETS=0
INGEST_OCR=0

# memory (default) or postgres; use postgres when running more than one instance
RATE_LIMIT_STORE=memory
