{
  "name": "rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:eval": "vitest run test/rag/eval.test.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "storage:retry": "node scripts/retry-blob-deletions.mjs",
    "reindex": "node scripts/reindex-documents.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
    "db:migrate": "prisma migrate dev --create-only",
    "db:apply": "node scripts/check-vector-index.mjs && prisma migrate deploy && prisma generate",
    "db:check": "node scripts/check-vector-index.mjs",
    "db:index": "prisma db execute --file prisma/sql/chunk-embedding-index.sql",
    "db:studio": "prisma studio",
    "auth:generate": "npx auth@latest generate --yes"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.120",
    "@ai-sdk/react": "4.0.176",
    "@base-ui/react": "^1.9.0",
    "@better-auth/prisma-adapter": "1.7.22",
    "@getbrevo/brevo": "6.2.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.1.1",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/blob": "2.9.0",
    "ai": "7.0.172",
    "better-auth": "1.7.22",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.72.0",
    "mammoth": "1.13.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
